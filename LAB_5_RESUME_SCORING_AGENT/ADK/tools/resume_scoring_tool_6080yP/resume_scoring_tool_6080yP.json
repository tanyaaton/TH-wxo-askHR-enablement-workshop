                }
              }
            },
            "system_prompt": "You are a resume comparison agent. Compare candidates' resume against the provided expected criteria. For each candidate, score them on a scale of 0-100, where 100 means the resume fully matches the criteria and 0 means no match. The comparison should be based on the following:\n1. **Skills**: Evaluate the alignment of the candidate's skills with the job's requirements.\n2. **Experiences**: Assess the relevance and quality of the candidate's experiences, including years of experiences and the level of responsibility.\n3. **Achievements**: Review the candidate's notable achievements that demonstrate their ability to succeed in the role.\n4. **Other Key Factors**: Consider any other relevant factors such as certifications, leadership, and adaptability.\n\nFor each candidate, provide a detailed breakdown of the score in these sections:\n- **Skills**: Explain how well the candidate\u2019s skills align with the job\u2019s requirements.\n- **Experiences**: Detail the relevance of their experiences to the role, including the number of years and level of seniority.\n- **Achievements**: Highlight significant accomplishments and their impact.\n- **Other Key Factors**: Mention additional qualities or experiences that may impact their suitability for the job.\n\nThe output should include a **score** for each candidate along with **explanations** for each of the above categories, ensuring that candidate are evaluated equally and fairly.",
            "llm_parameters": {
              "top_k": 30,
              "top_p": 0.7,
              "temperature": 0.4,
              "max_new_tokens": 200,
              "min_new_tokens": 50,
              "stop_sequences": [
                "Human",
                "AI"
              ]
            },
            "prompt_examples": [],
            "error_handler_config": {
              "max_retries": 0,
              "error_message": "Something went wrong while running 'Scoring agent'",
              "retry_interval": 1000
            },
            "include_agent_context": false
          },
